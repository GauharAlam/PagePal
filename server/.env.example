PORT=5001
MONGODB_URI=mongodb+srv://username:password@cluster0.xxx.mongodb.net/PagePal?retryWrites=true&w=majority
NODE_ENV=development
ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  CLERK AUTHENTICATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Clerk Secret Key — required for token verification
# Get it from https://dashboard.clerk.com/apps/[app-id]/api-keys
CLERK_SECRET_KEY=sk_test_M6GLtbzAd8GMDgncG13dJf4qdE2NDQ8QQ57F2Ojddy

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  AI MODEL API KEYS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ✅ REQUIRED — NVIDIA is the default model and universal fallback.
#    It handles ALL tasks even if every other key below is missing.
#    Get your free key → https://build.nvidia.com/
NVIDIA_API_KEY=

# ── Optional keys — each one unlocks smarter routing for that content type.
#    If any key below is missing, NVIDIA handles those tasks automatically.

# ✦ Gemini (Google) — long articles, YouTube transcripts, large documents
#    Free tier: 15 requests/min, 1500 requests/day
#    Get your free key → https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ⚡ OpenAI (GPT-4o-mini) — standard articles, blogs, general Q&A
#    Get key → https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 🔍 DeepSeek — code explanation and technical content (very cost-efficient)
#    Get key → https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 𝕏  Grok (xAI) — trending topics, news, social media content
#    Get key → https://console.x.ai/
GROK_API_KEY=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  RATE LIMITING
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

MAX_REQUESTS_PER_MINUTE=30

