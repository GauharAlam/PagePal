PORT=3001
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# AI Providers (at least one required)
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=z-ai/glm-4.5

# Encryption secret for BYOK user API keys (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_SECRET=your_64_char_hex_secret_here

# Stripe (Pro $9/mo)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# Frontend for Stripe redirects & CORS allowlist (prod)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=https://your-landing.vercel.app,https://pagepal.ai
MAX_REQUESTS_PER_MINUTE=60
